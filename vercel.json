{
  "crons": [
    {
      "path": "/api/canopy/refresh",
      "schedule": "0 13 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "acornsoft.ai" }],
      "destination": "https://www.acornsoft.ai/:path*",
      "permanent": true
    },
    {
      "source": "/docs/onboarding",
      "destination": "/luna",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/README.md",
      "destination": "/luna",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/01-grok-build.md",
      "destination": "/luna/grok-build",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/02-github-copilot.md",
      "destination": "/luna/copilot",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/03-cursor.md",
      "destination": "/luna/cursor",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/04-claude.md",
      "destination": "/luna/claude",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/SECURITY-PRIVACY-ETHICS.md",
      "destination": "/luna/security",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/VISUAL-GUIDE.md",
      "destination": "/luna/visual-guide",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/SURFACE-REQUIREMENTS.md",
      "destination": "/luna/surface",
      "permanent": true
    },
    {
      "source": "/docs/onboarding/GROK-KEYBINDINGS-VS-CODE.md",
      "destination": "/luna/grok-keys",
      "permanent": true
    },
    {
      "source": "/SUPPORT.md",
      "destination": "/luna/support",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://dc.services.visualstudio.com https://*.in.applicationinsights.azure.com https://js.monitor.azure.com https://*.monitor.azure.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), xr-spatial-tracking=()"
        }
      ]
    }
  ]
}
